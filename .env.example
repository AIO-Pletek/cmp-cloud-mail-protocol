# CMP Mail Platform - Environment Configuration
# Copy to /opt/cmp/.env and customize for your deployment
# Keep this file secure - it contains sensitive credentials

# Database
DATABASE_URL=postgresql+asyncpg://cmp:CHANGE_ME_HERE@127.0.0.1:5432/cmp
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cmp
DB_USER=cmp
DB_PASSWORD=CHANGE_ME_HERE

# Application
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
APP_ENV=production
APP_URL=https://mail.cmp.local
PORTAL_URL=https://mail.cmp.local
API_WORKERS=4

# Mail Server
MAIL_HOSTNAME=mail.cmp.local
MAIL_DOMAIN=cmp.local
POSTMASTER_EMAIL=postmaster@cmp.local

# ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Rspamd
RSPAMD_URL=http://127.0.0.1:11334
RSPAMD_PASSWORD=CHANGE_ME_HERE

# Redis
REDIS_URL=redis://127.0.0.1:CHANGE_ME_HERE/0

# TLS/SSL
TLS_CERT_FILE=/etc/ssl/certs/cmp.pem
TLS_KEY_FILE=/etc/ssl/private/cmp.key

# DKIM
DKIM_SELECTOR=cmp
DKIM_KEY_DIR=/var/lib/rspamd/dkim

# Quarantine
QUARANTINE_RETENTION_DAYS=30
QUARANTINE_DIR=/var/mail/quarantine

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/cmp/api.log

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:CHANGE_ME_HERE/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:CHANGE_ME_HERE/2
CELERY_WORKER_CONCURRENCY=4

# Backup
BACKUP_DIR=/opt/cmp/backups
BACKUP_RETENTION_DAYS=30

# DNS
DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_TIMEOUT=5
