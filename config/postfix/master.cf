# CMP Postfix Master Configuration
# /etc/postfix/master.cf

# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ==========================================================================

# SMTP service - main listener
smtp      inet  n       -       y       -       -       smtpd
  -o content_filter=smtp:[127.0.0.1]:10025
  -o smtpd_tls_security_level=may
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject

# Submission port (587) - authenticated clients only
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_sasl_type=dovecot
  -o smtpd_sasl_path=private/auth
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
  -o content_filter=smtp:[127.0.0.1]:10025

# SMTPS port (465) - implicit TLS
smtps     inet  n       -       y       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_sasl_type=dovecot
  -o smtpd_sasl_path=private/auth
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
  -o content_filter=smtp:[127.0.0.1]:10025

# Rspamd re-injection (after content filtering)
127.0.0.1:10025 inet n  -       y       -       -       smtpd
  -o syslog_name=postfix/rspamd-reinject
  -o content_filter=
  -o mynetworks=127.0.0.0/8
  -o smtpd_restriction_classes=
  -o smtpd_client_restrictions=
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_data_restrictions=reject_unauth_pipelining
  -o smtpd_end_of_data_restrictions=
  -o smtpd_milters=

# Cleanup
cleanup   unix  n       -       y       -       0       cleanup

# Qmgr and Pickup
qmgr      unix  n       -       n       300     1       qmgr
pickup    unix  n       -       n       60      1       pickup

# Rewrite and Bounce
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       y       -       1       verify

# Proxymap
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap

# LMTP to Dovecot
lmtp      unix  -       -       y       -       -       lmtp

# Relay
relay     unix  -       -       y       -       -       smtp
  -o smtp_fallback_relay=

# Error and retry
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       local

# Showq
showq     unix  n       -       n       -       -       showq

# Old-style flush
flush     unix  n       -       n       1000?   0       flush

# SMTP direct delivery
smtp      unix  -       -       y       -       -       smtp

# Postscreen (optional anti-spam pre-filter on port 25)
# postscreen unix n     -       y       -       1       postscreen

# Dovecot SASL auth socket
# (Dovecot delivers this socket at /var/spool/postfix/private/auth)
